# Copia este fichero como ".env" (sin ".example") y rellena tu clave real.
# El fichero ".env" NUNCA se sube a ningún sitio ni se comparte: solo vive en tu PC.

# Clave de API de Anthropic (consola.anthropic.com -> API Keys -> proyecto "api-crm")
ANTHROPIC_API_KEY=

# Umbral de aviso de gasto mensual de la API, en euros. Al superarlo, la interfaz
# muestra un aviso (no bloquea el chat). Déjalo vacío para usar el valor por defecto (15).
AI_MONTHLY_SPEND_ALERT_EUR=15

# --- Solo necesarias al desplegar en un hosting (Fase 7, no en local/Electron) ---

# Puerto en el que escucha el servidor. En local se usa 4000 si no se define.
# En Hostinger lo define el propio gestor de Web Apps Node.js: pon ahí la
# variable de entorno PORT que te indique su panel (no hace falta tocar este
# fichero, se configura en hPanel).
PORT=4000

# Carpeta donde vive data.sqlite, .enc.key y las copias de seguridad. En local
# por defecto es ./data dentro de la propia app. En el hosting debe apuntar a
# una ruta persistente FUERA de la carpeta que se sirve como pública (para que
# un redeploy no la borre y para que nunca quede accesible como estático).
# Pide a Hostinger cuál es esa ruta persistente de tu Web App.
RCP_DATA_DIR=

# Pon ambas a 1 SOLO cuando el CRM se sirva por HTTPS detrás de un proxy
# (Hostinger, Nginx...): hace que las cookies de sesión viajen solo por HTTPS
# y que Express confíe en la cabecera que le indica el proxy. En local /
# Electron (HTTP plano) se dejan sin definir.
RCP_TRUST_PROXY=1
RCP_COOKIE_SECURE=1

# --- Bandeja de correo con borrador IA (Fase 8) ---
# Si faltan estas variables, la pantalla "Correo" sigue visible pero avisa de que
# no está conectada; el resto del CRM funciona igual. Comprueba en hPanel ->
# Correo -> tu cuenta -> "Configuración del cliente de correo" si tiene IMAP/SMTP
# externo habilitado (algunos planes de Hostinger lo restringen).

# Mismo servidor para IMAP (leer) y SMTP (enviar) en la mayoría de cuentas de
# Hostinger, p. ej. imap.hostinger.com / smtp.hostinger.com — confírmalo en hPanel.
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SECURE=true
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=

EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

